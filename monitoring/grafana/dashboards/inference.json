{
  "uid": "inference-overview",
  "title": "Inference Service Overview",
  "description": "Inference API, worker proxies and runtime health; scraped every five seconds.",
  "schemaVersion": 41,
  "version": 6,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "inference",
    "infra"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Requests per second",
      "description": "Arrival rate for POST /predict, including failed requests; successful responses are shown separately. Durable /jobs admission is not counted here.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(predict_requests_total{job=~\"inference-api|inference-gateway\"}[$__rate_interval]))",
          "legendFormat": "Arrivals",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(predict_responses_total{job=~\"inference-api|inference-gateway\",status_code=\"200\"}[$__rate_interval]))",
          "legendFormat": "Successful responses (200)",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 2,
      "title": "Response ratios",
      "description": "Completed /predict response ratios: 503 unavailable or admission rejection, 500 internal error, 504 deadline expiry, 422 invalid input. No ratio is shown without requests.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (status_code) (rate(predict_responses_total{job=~\"inference-api|inference-gateway\",status_code=~\"422|500|503|504\"}[$__rate_interval])) / scalar(sum(rate(predict_responses_total{job=~\"inference-api|inference-gateway\"}[$__rate_interval])))) and on() (sum(rate(predict_responses_total{job=~\"inference-api|inference-gateway\"}[$__rate_interval])) > 0)",
          "legendFormat": "HTTP {{status_code}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 3,
      "title": "Successful request latency",
      "description": "Histogram estimate for successful /predict server latency, including queueing but excluding client network time. No P95 is available without successful responses.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(predict_duration_seconds_bucket{job=~\"inference-api|inference-gateway\",status_code=\"200\"}[$__rate_interval])))",
          "legendFormat": "Successful P95",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 4,
      "title": "Since API startup",
      "description": "Cumulative /predict arrivals in the current API process. Resets on process restart; historical Prometheus samples remain.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(predict_requests_total{job=~\"inference-api|inference-gateway\"})",
          "legendFormat": "Arrivals since startup",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 5,
      "title": "Retry activity",
      "description": "Simulation retry acceptance and completion event rates. These are not SQL durable-job retry counters or a matched-cohort success ratio.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(inference_retry_submissions_total{job=~\"inference-api|inference-gateway\"}[$__rate_interval]))",
          "legendFormat": "Accepted",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(inference_retry_completions_total{job=~\"inference-api|inference-gateway\"}[$__rate_interval]))",
          "legendFormat": "Completed",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 6,
      "title": "Accepted retries",
      "type": "stat",
      "description": "Estimated accepted simulation retry events over the selected range; handles counter resets. Extrapolation can produce fractional values.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(inference_retry_submissions_total{job=~\"inference-api|inference-gateway\"}[$__range]))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 7,
      "title": "Completed retries",
      "type": "stat",
      "description": "Estimated completed simulation retry events over the selected range; handles counter resets. Extrapolation can produce fractional values.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(inference_retry_completions_total{job=~\"inference-api|inference-gateway\"}[$__range]))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 8,
      "title": "Registered workers",
      "description": "Workers currently discovered or statically configured by the API. Discovery does not prove model health or free capacity.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(inference_registered_workers{job=~\"inference-api|inference-gateway\"})",
          "legendFormat": "Registered",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 9,
      "title": "API queue depth",
      "description": "Tasks in the shared API queue. Excludes SQL-only jobs, scheduler buffers, proxy queues and active RPCs. Five-second scraping can miss brief peaks.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(inference_api_queue_depth{job=~\"inference-api|inference-gateway\"})",
          "legendFormat": "Queued",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 10,
      "title": "Queued batches",
      "description": "Waiting batches in each API-side worker proxy. Excludes the active batch and the shared API queue. A batch can contain multiple tasks. Five-second scraping can miss brief peaks.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "inference_worker_queued_batches{job=~\"inference-api|inference-gateway\"}",
          "legendFormat": "{{worker_id}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 11,
      "title": "Active inference RPCs",
      "description": "Inference calls in flight from each API-side proxy. Each proxy dispatches serially, so its value is zero or one. This is not remote CPU/GPU utilization or a count of all server RPCs.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 41,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "inference_worker_active_rpcs{job=~\"inference-api|inference-gateway\"}",
          "legendFormat": "{{worker_id}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          },
          "decimals": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 12,
      "title": "Routing lifecycle",
      "description": "One indicates the current lifecycle state observed by this API. READY accepts new batches within capacity; DRAINING rejects new admission without cancelling accepted work. Removed workers stop exporting their series; historical samples remain in Prometheus.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 50,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "inference_worker_routing_state{job=~\"inference-api|inference-gateway\"}",
          "legendFormat": "{{worker_id}} {{state}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          },
          "decimals": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 13,
      "title": "Runtime loop health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 59,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "inference_runtime_loop_healthy",
          "legendFormat": "{{loop}} {{alertname}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "One means the thread is alive and recently completed a successful cycle. This does not certify model progress."
    },
    {
      "id": 14,
      "title": "Runtime cycle age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 59,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "inference_runtime_loop_last_cycle_age_seconds",
          "legendFormat": "{{loop}} {{alertname}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Monotonic seconds since the last successful scheduler or durable gateway cycle."
    },
    {
      "id": 15,
      "title": "Firing runtime alerts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 67,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertname=~\"Inference.*\",alertstate=\"firing\"}",
          "legendFormat": "{{loop}} {{alertname}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Alerts that remain firing after their sustained-failure window. External notification delivery is configured separately."
    }
  ]
}
